# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# AWS Region hosting Amazon Bedrock models and DynamoDB
# e.g., ap-southeast-2 (Sydney), us-east-1 (N. Virginia), ap-south-1 (Mumbai)
AWS_REGION=ap-southeast-2

# Amazon Bedrock Model ID
# Must support Bedrock Converse API and have Model Access approved in AWS Console.
# Examples:
# - amazon.nova-micro-v1:0 (Cost-effective Amazon model)
# - amazon.nova-lite-v1:0
# - us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Optional Inference Configuration
BEDROCK_MAX_TOKENS=2048

# AWS DynamoDB Configuration
# Table for persistent long-term memories
DYNAMODB_TABLE_NAME=LongTermMemory

# Optional: Default development user ID
DEFAULT_USER_ID=test-user-1

# NOTE: AWS credentials should NOT be placed in this file.
# Configure credentials securely via AWS CLI (`aws configure`) or IAM roles.
