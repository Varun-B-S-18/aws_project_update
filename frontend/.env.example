# API Base URL (leave empty in local development to use Vite's built-in /api proxy)
VITE_API_BASE_URL=

# AWS Configuration (Public non-secret identifiers only)
# DO NOT place IAM access keys or secrets in this file.
VITE_AWS_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

